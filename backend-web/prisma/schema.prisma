datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  username      String
  password_hash String?
  global_xp     Int      @default(0)
  global_level  Int      @default(1)
  current_title String?
  created_at    DateTime @default(now())

  character     Character?
  skills        Skill[]
  transactions  XPTransaction[]
  quests        Quest[]
  achievements  UserAchievement[]
  titles        UserTitle[]
  dailyLogs     DailyLog[]
  chapters      WeeklyChapter[]
}

model Character {
  id              String   @id @default(uuid())
  user_id         String   @unique
  name            String
  class           String
  origin_story    String
  avatar_url      String
  current_rank    String   @default("E")
  weight          String?
  height          String?
  fitness_goals   String?
  momentum        Int      @default(50)
  last_action     DateTime @default(now())

  // Core stats (XP-based)
  wisdom_xp       Int      @default(0)
  wisdom_lvl      Int      @default(1)
  mobility_xp     Int      @default(0)
  mobility_lvl    Int      @default(1)
  strength_xp     Int      @default(0)
  strength_lvl    Int      @default(1)
  willpower_xp    Int      @default(0)
  willpower_lvl   Int      @default(1)

  // Mindset stats (Baseline + XP-based)
  execution_base  Int      @default(5)
  execution_xp    Int      @default(0)
  execution_lvl   Int      @default(5)
  adaptability_base Int    @default(5)
  adaptability_xp   Int    @default(0)
  adaptability_lvl  Int    @default(5)
  resilience_base   Int    @default(5)
  resilience_xp     Int    @default(0)
  resilience_lvl    Int    @default(5)
  self_awareness_base Int  @default(5)
  self_awareness_xp   Int    @default(0)
  self_awareness_lvl  Int    @default(5)
  ego_resistance_base Int  @default(5)
  ego_resistance_xp   Int    @default(0)
  ego_resistance_lvl  Int    @default(5)

  created_at      DateTime @default(now())

  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  snapshots       CharacterSnapshot[]
}

model CharacterSnapshot {
  id                 String   @id @default(uuid())
  character_id       String
  avatar_url         String
  rank               String
  level              Int
  title              String
  narrative          String
  weight             String?
  height             String?
  momentum           Int      @default(50)
  wisdom_lvl         Int      @default(1)
  mobility_lvl       Int      @default(1)
  strength_lvl       Int      @default(1)
  willpower_lvl      Int      @default(1)
  execution_lvl      Int      @default(5)
  adaptability_lvl   Int      @default(5)
  resilience_lvl     Int      @default(5)
  self_awareness_lvl  Int      @default(5)
  ego_resistance_lvl  Int      @default(5)
  created_at         DateTime @default(now())

  character          Character @relation(fields: [character_id], references: [id], onDelete: Cascade)
}

model Skill {
  id          String   @id @default(uuid())
  user_id     String
  name        String
  description String
  category    String
  rank        String   @default("E")
  xp          Int      @default(0)
  level       Int      @default(1)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  user         User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions XPTransaction[]
}

model XPTransaction {
  id         String   @id @default(uuid())
  user_id    String
  skill_id   String?
  xp_amount  Int
  reason     String
  source     String
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  skill      Skill?   @relation(fields: [skill_id], references: [id], onDelete: SetNull)
}

model Quest {
  id          String    @id @default(uuid())
  user_id     String
  title       String
  description String
  difficulty  String    // E, D, C, B, A, S
  xp_reward   Int
  status      String    // ACTIVE, COMPLETED, FAILED
  quest_type  String    // MAIN, SIDE, ELITE, BOSS
  due_date    DateTime?
  created_at  DateTime  @default(now())

  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Achievement {
  id                  String   @id @default(uuid())
  name                String
  description         String
  badge               String   // Icon indicator
  unlock_requirements String   // Requirements details

  userAchievements    UserAchievement[]
}

model UserAchievement {
  id             String   @id @default(uuid())
  user_id        String
  achievement_id String
  earned_at      DateTime @default(now())

  user           User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  achievement    Achievement @relation(fields: [achievement_id], references: [id], onDelete: Cascade)
}

model Title {
  id                  String   @id @default(uuid())
  name                String
  description         String
  unlock_requirements String

  userTitles          UserTitle[]
}

model UserTitle {
  id         String   @id @default(uuid())
  user_id    String
  title_id   String
  earned_at  DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title      Title    @relation(fields: [title_id], references: [id], onDelete: Cascade)
}

model DailyLog {
  id              String   @id @default(uuid())
  user_id         String
  notes           String
  mood            String
  energy          Int
  system_analysis String?  // Store the epic narration from The System
  weight          String?  // Recorded weight
  created_at      DateTime @default(now())

  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model WeeklyChapter {
  id             String   @id @default(uuid())
  user_id        String
  chapter_number Int
  title          String
  narrative      String
  created_at     DateTime @default(now())

  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

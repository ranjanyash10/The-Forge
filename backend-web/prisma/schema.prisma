datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  username      String
  password_hash String?
  global_xp     Int      @default(0)
  global_level  Int      @default(1)
  current_title String?
  created_at    DateTime @default(now())

  character     Character?
  skills        Skill[]
  transactions  XPTransaction[]
  quests        Quest[]
  achievements  UserAchievement[]
  titles        UserTitle[]
  dailyLogs     DailyLog[]
  chapters      WeeklyChapter[]
  systemMessages SystemMessage[]
  bossBattles   BossBattle[]
  codexEntries  CodexEntry[]
  systemAssertions SystemAssertion[]
}

model Character {
  id              String   @id @default(uuid())
  user_id         String   @unique
  name            String
  class           String
  origin_story    String
  avatar_url      String
  current_rank    String   @default("E")
  weight          String?
  height          String?
  fitness_goals   String?
  state_json      String?  @default("{}")
  momentum        Int      @default(50)
  last_action     DateTime @default(now())

  // Core stats (XP-based)
  wisdom_xp       Int      @default(0)
  wisdom_lvl      Int      @default(1)
  mobility_xp     Int      @default(0)
  mobility_lvl    Int      @default(1)
  strength_xp     Int      @default(0)
  strength_lvl    Int      @default(1)
  willpower_xp    Int      @default(0)
  willpower_lvl   Int      @default(1)

  // Mindset stats (Baseline + XP-based)
  execution_base  Int      @default(5)
  execution_xp    Int      @default(0)
  execution_lvl   Int      @default(5)
  adaptability_base Int    @default(5)
  adaptability_xp   Int    @default(0)
  adaptability_lvl  Int    @default(5)
  resilience_base   Int    @default(5)
  resilience_xp     Int    @default(0)
  resilience_lvl    Int    @default(5)
  self_awareness_base Int  @default(5)
  self_awareness_xp   Int    @default(0)
  self_awareness_lvl  Int    @default(5)
  ego_resistance_base Int  @default(5)
  ego_resistance_xp   Int    @default(0)
  ego_resistance_lvl  Int    @default(5)

  created_at      DateTime @default(now())

  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  snapshots       CharacterSnapshot[]
}

model CharacterSnapshot {
  id                 String   @id @default(uuid())
  character_id       String
  avatar_url         String
  rank               String
  level              Int
  title              String
  narrative          String
  weight             String?
  height             String?
  momentum           Int      @default(50)
  wisdom_lvl         Int      @default(1)
  mobility_lvl       Int      @default(1)
  strength_lvl       Int      @default(1)
  willpower_lvl      Int      @default(1)
  execution_lvl      Int      @default(5)
  adaptability_lvl   Int      @default(5)
  resilience_lvl     Int      @default(5)
  self_awareness_lvl  Int      @default(5)
  ego_resistance_lvl  Int      @default(5)
  created_at         DateTime @default(now())

  character          Character @relation(fields: [character_id], references: [id], onDelete: Cascade)
}

model Skill {
  id          String   @id @default(uuid())
  user_id     String
  name        String
  description String
  category    String
  rank        String   @default("E")
  xp          Int      @default(0)
  level       Int      @default(1)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  user         User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions XPTransaction[]
}

model XPTransaction {
  id         String   @id @default(uuid())
  user_id    String
  skill_id   String?
  xp_amount  Int
  reason     String
  source     String
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  skill      Skill?   @relation(fields: [skill_id], references: [id], onDelete: SetNull)
}

model Quest {
  id          String    @id @default(uuid())
  user_id     String
  title       String
  description String
  difficulty  String    // E, D, C, B, A, S
  xp_reward   Int
  status      String    // ACTIVE, COMPLETED, FAILED
  quest_type  String    // MAIN, SIDE, ELITE, BOSS
  due_date    DateTime?
  reason      String?
  is_hidden   Boolean   @default(false)
  created_at  DateTime  @default(now())

  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Achievement {
  id                  String   @id @default(uuid())
  name                String
  description         String
  badge               String   // Icon indicator
  unlock_requirements String   // Requirements details

  userAchievements    UserAchievement[]
}

model UserAchievement {
  id             String   @id @default(uuid())
  user_id        String
  achievement_id String
  earned_at      DateTime @default(now())

  user           User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  achievement    Achievement @relation(fields: [achievement_id], references: [id], onDelete: Cascade)
}

model Title {
  id                  String   @id @default(uuid())
  name                String
  description         String
  unlock_requirements String

  userTitles          UserTitle[]
}

model UserTitle {
  id         String   @id @default(uuid())
  user_id    String
  title_id   String
  earned_at  DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title      Title    @relation(fields: [title_id], references: [id], onDelete: Cascade)
}

model DailyLog {
  id              String   @id @default(uuid())
  user_id         String
  notes           String
  mood            String
  energy          Int
  system_analysis String?  // Store the epic narration from The System
  weight          String?  // Recorded weight
  created_at      DateTime @default(now())

  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model WeeklyChapter {
  id             String   @id @default(uuid())
  user_id        String
  chapter_number Int
  title          String
  narrative      String
  created_at     DateTime @default(now())

  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model SystemMessage {
  id         String   @id @default(uuid())
  user_id    String
  sender     String   // "SYSTEM" or "USER"
  content    String
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model BossBattle {
  id                  String         @id @default(uuid())
  userId              String         @map("user_id")
  title               String         
  description         String
  epicManifesto       String         @map("epic_manifesto")
  
  // Refactored Engine Analytics
  difficultyScore     Int            @map("difficulty_score")
  calculatedRank      String         @map("calculated_rank") // E, D, C, B, A, S, SS, SSS
  preparationScore    Int            @default(0) @map("preparation_score")
  victoryProbability  Int            @map("victory_probability")
  predictionReasoning String         @default("[]") @map("prediction_reasoning") // SQLite compatible Json String
  
  // Core Operational States
  status              String         @default("IDENTIFIED") // IDENTIFIED, PREPARATION, ACTIVE, RESOLVED
  outcome             String?        @map("outcome")        // VICTORIOUS, WITHDRAWN, INTERRUPTED, OVERWHELMED
  originSource        String         @default("USER_DECLARATION") // USER_DECLARATION, SYSTEM_EMERGENT
  
  attemptsCount       Int            @default(1) @map("attempts_count")
  timeLimitHours      Int            @map("time_limit_hours")
  
  // Consequence Array Anchors
  unlockedSkills      String         @default("[]") @map("unlocked_skills") // SQLite compatible String
  consequenceNarrative String?       @map("consequence_narrative")
  
  initiatedAt         DateTime?      @map("initiated_at")
  resolvedAt          DateTime?      @map("resolved_at")
  createdAt           DateTime       @default(now()) @map("created_at")

  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  phases              BossPhase[]
  archiveChapter      ArchiveChapter?

  @@map("boss_battles")
}

model BossPhase {
  id           String     @id @default(uuid())
  bossBattleId String     @map("boss_battle_id")
  title        String     
  isCompleted  Boolean    @default(false) @map("is_completed")
  completedAt  DateTime?  @map("completed_at")

  bossBattle   BossBattle @relation(fields: [bossBattleId], references: [id], onDelete: Cascade)

  @@map("boss_phases")
}

model ArchiveChapter {
  id             String     @id @default(uuid())
  bossBattleId   String     @unique @map("boss_battle_id")
  chapterTitle   String     @map("chapter_title")
  durationDays   Int        @map("duration_days")
  lessonsLearned String     @map("lessons_learned")
  createdAt      DateTime   @default(now()) @map("created_at")

  bossBattle     BossBattle @relation(fields: [bossBattleId], references: [id], onDelete: Cascade)

  @@map("archive_chapters")
}

model CodexEntry {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  
  // The Refactored Typology
  type           String   // "BELIEF", "DECLARATION", "TURNING_POINT", "VALUE", "RELATIONSHIP_AXIS", "ANNUAL_REFLECTION", "SILENCE_GAP"
  importance     String   // "COMMON", "HIGH", "EPIC", "LEGENDARY"
  
  // The Subjective Perspective Shift
  narrativeState String   @map("narrative_state")
  rawUserQuote   String   @map("raw_user_quote")
  
  // Resolution Tracking (For historical contrast)
  isChallenged   Boolean  @default(false) @map("is_challenged")
  resolutionNote String?  @map("resolution_note")
  
  // Retcon & Correction Telemetry
  isRetconned    Boolean  @default(false) @map("is_retconned")
  retconReason   String?  @map("retcon_reason")
  userCorrectionCount Int   @default(0) @map("user_correction_count")

  linkedEntities String   @default("[]") @map("linked_entities") // SQLite compatible String
  createdAt      DateTime @default(now()) @map("created_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("codex_entries")
}

model SystemAssertion {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  claimText      String   @map("claim_text") // e.g., "Programming is your dominant vector."
  confidenceScore Float   @map("confidence_score")  // 0.00 to 1.00
  
  // The Evidence Layer Array Maps (SQLite compatible strings)
  evidenceLogs   String   @default("[]") @map("evidence_logs")
  linkedCodexIds String   @default("[]") @map("linked_codex_ids")
  
  status         String   @default("PENDING_VALIDATION") // PENDING_VALIDATION, ACCEPTED, REFUTED
  createdAt      DateTime @default(now()) @map("created_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("system_assertions")
}
